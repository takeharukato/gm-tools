#: src/gm_tools/gather_cli.py:112
msgid ""
"gm-gather: download remote files via SFTP (or remote tar) to a local DEST.\n"
"Usage: gm-gather [SRC ...] DEST\n"
"  - SRC:\n"
"      * '/...': absolute on remote (UNIX)\n"
"      * 'X:/...': absolute on remote (Windows)\n"
"      * '~/...': expanded by -u user's HOME on remote\n"
"      * RELATIVE: treated as '-u' user's HOME-relative,\n"
"                  HOME escape via '..' is rejected.\n"
"    The portion after the root is treated as a regex path.\n"
"    e.g., '/etc/hosts' (literal), '/var/log/.*\\.log' (regex), '~/foo/.*', "
"'var/log/.*'.\n"
"  - DEST: local directory where files are stored as DEST/<HOST>/..."
msgstr ""

#: src/gm_tools/gather_cli.py:130
msgid ""
"One or more SRC path patterns. Absolute ('/','X:/','~/') or HOME-relative."
msgstr ""

#: src/gm_tools/gather_cli.py:132
msgid "Local destination directory."
msgstr ""

#: src/gm_tools/gather_cli.py:137
#, python-format
msgid "Target account on remote %(default)s."
msgstr ""

#: src/gm_tools/gather_cli.py:138
msgid "Show plan only; do not download."
msgstr ""

#: src/gm_tools/gather_cli.py:139
msgid "Pack on remote (tar.gz) and download once."
msgstr ""


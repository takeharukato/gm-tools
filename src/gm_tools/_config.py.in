# -*- coding: utf-8 -*-
"""
gm_tools._config
================

This file is generated by ./configure from _config.py.in.
Do not edit this file manually.
"""

# configure --prefix=... / --exec-prefix=... の結果
PREFIX: str = "@prefix@"
EXEC_PREFIX: str = "@exec_prefix@"

# datarootdir / localedir は GNU 的なテンプレートとして保持
DATAROOTDIR: str = "@datarootdir@"   # 例: "${prefix}/share" または "/opt/share"
LOCALEDIR: str = "@localedir@"       # 例: "${datarootdir}/locale"

# gettext ドメイン名 (po/Makevars の DOMAIN, GETTEXT_PACKAGE と一致させる)
DOMAIN: str = "@GETTEXT_PACKAGE@"

# パッケージ名・バージョン
PACKAGE_NAME: str = "@PACKAGE_NAME@"
PACKAGE_VERSION: str = "@VERSION@"
